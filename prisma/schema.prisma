// Database schema. Models are added as the spec defines them.

generator client {
  provider            = "prisma-client"
  output              = "../server/generated/prisma"
  // .js import extensions keep the generated code runnable in Vercel's Node runtime.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Family {
  id              String   @id @default(cuid())
  slug            String   @unique
  displayName     String
  question        String
  acceptedAnswers String[]
  createdAt       DateTime @default(now())

  people       Person[]
  gateAttempts GateAttempt[]
  updates      Update[]
}

enum Role {
  family
  supporter
}

// Family members and supporters. An email belongs to at most one person in a family.
model Person {
  id               String    @id @default(cuid())
  familyId         String
  role             Role
  // Both empty for a supporter who has only answered the question; both set once they
  // give an email. Family members always have both.
  name             String?
  email            String? // lowercased and trimmed
  // Set when the person confirms their email, signs in by magic link, or a family member verifies it.
  emailVerifiedAt  DateTime?
  // Supporters only: whether new updates are emailed to them.
  notificationsOn  Boolean   @default(true)
  // In each notification email's unsubscribe links. Stored as is: it can only turn off
  // this person's notifications. Generated by the database so existing rows get one.
  unsubscribeToken String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Supporters only: set when a family member removes them. A removed person can't sign
  // in, join again, or get emails; the record stays so the email stays blocked.
  removedAt        DateTime?
  createdAt        DateTime  @default(now())

  family     Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  magicLinks MagicLink[]
  sessions   Session[]
  updates    Update[]
  reactions  Reaction[]

  @@unique([familyId, email])
}

// A sign-in link starts a session; a verify link only confirms the email.
enum LinkPurpose {
  sign_in
  verify
}

model MagicLink {
  id        String      @id @default(cuid())
  personId  String
  purpose   LinkPurpose @default(sign_in)
  tokenHash String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  personId  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Update {
  id        String    @id @default(cuid())
  familyId  String
  authorId  String
  // The text blocks joined by blank lines, kept so the version before blocks still works.
  // The content itself is in `blocks`.
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author    Person     @relation(fields: [authorId], references: [id])
  reactions Reaction[]
  blocks    Block[]

  @@index([familyId, createdAt])
}

enum BlockKind {
  text
  photo
}

// One piece of an update's content, in order. Only text blocks exist so far.
model Block {
  id       String    @id @default(cuid())
  updateId String
  position Int
  kind     BlockKind
  text     String?

  update Update @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@unique([updateId, position])
}

// The fixed set of reactions; the UI gives each its emoji and label.
enum ReactionKind {
  heart
  pray
  hug
  strong
  party
  laugh
}

// A person's one reaction to an update; picking another replaces it.
model Reaction {
  id        String       @id @default(cuid())
  updateId  String
  personId  String
  kind      ReactionKind
  createdAt DateTime     @default(now())

  update Update @relation(fields: [updateId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([updateId, personId])
}

// A wrong answer at a family's gate, counted against per-browser and per-network limits.
model GateAttempt {
  id        String   @id @default(cuid())
  familyId  String
  browserId String
  network   String
  createdAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, browserId, createdAt])
  @@index([familyId, network, createdAt])
}
