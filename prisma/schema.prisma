// Database schema. Models are added as the spec defines them.

generator client {
  provider            = "prisma-client"
  output              = "../server/generated/prisma"
  // .js import extensions keep the generated code runnable in Vercel's Node runtime.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Family {
  id              String   @id @default(cuid())
  slug            String   @unique
  displayName     String
  question        String
  acceptedAnswers String[]
  // The message at the top of How to help, trimmed; null when there is none.
  helpMessage     String?
  // The emoji anyone may react with on any of the family's notes, in catalog order; empty allows none.
  noteReactionKinds String[] @default(["heart", "hug", "strong", "clap", "party", "laugh"])
  createdAt       DateTime @default(now())

  people       Person[]
  gateAttempts GateAttempt[]
  updates      Update[]
  helpRequests HelpRequest[]
}

enum Role {
  family
  supporter
}

// Family members and supporters. An email belongs to at most one person in a family.
model Person {
  id               String    @id @default(cuid())
  familyId         String
  role             Role
  // Both empty for a supporter who has only answered the question. A supporter gets a
  // name when they leave a note or give an email, and an email only by giving one.
  // Family members always have both.
  name             String?
  email            String? // lowercased and trimmed
  // Set when the person confirms their email, signs in by magic link, or a family member verifies it.
  emailVerifiedAt  DateTime?
  // Whether new updates are emailed to them.
  notificationsOn  Boolean   @default(true)
  // In each notification email's unsubscribe links. Stored as is: it can only turn off
  // this person's notifications. Generated by the database so existing rows get one.
  unsubscribeToken String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Set when a family member removes them. A removed person can't sign in,
  // join again, or get emails; the record stays so the email stays blocked.
  removedAt        DateTime?
  // Supporters only, kept as typed: for the family to call or text them. Only family members
  // see it. A database check keeps it null for family members.
  phone            String?
  createdAt        DateTime  @default(now())

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  magicLinks   MagicLink[]
  sessions     Session[]
  updates      Update[]
  reactions     Reaction[]
  noteReactions NoteReaction[]
  notes         Note[]
  videoUploads  VideoUpload[]
  helpOffers    HelpOffer[]

  @@unique([familyId, email])
}

// A sign-in link starts a session; a verify link only confirms the email.
enum LinkPurpose {
  sign_in
  verify
}

model MagicLink {
  id        String      @id @default(cuid())
  personId  String
  purpose   LinkPurpose @default(sign_in)
  tokenHash String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  personId  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Update {
  id        String    @id @default(cuid())
  familyId  String
  authorId  String
  // The update's plain text, kept in step with content (see server/richText.ts).
  body      String
  // The formatted document, checked by validDoc. Null for updates posted before formatting,
  // and for a video update, which has a videoId and no document.
  content   Json?
  // A video update's Cloudinary public ID, from an upload ticket its author was given.
  // Null for a text update. Unique, so one upload is on at most one update.
  videoId   String?   @unique
  // The reactions anyone may pick on this update, as catalog kinds in catalog order (see
  // src/lib/reactionCatalog.ts), at most six. Empty allows none.
  reactionKinds String[] @default(["heart", "hug", "strong", "clap", "party", "laugh"])
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author    Person     @relation(fields: [authorId], references: [id])
  reactions Reaction[]
  notes     Note[]
  photos    Photo[]

  @@index([familyId, createdAt])
}

// A real photo's Cloudinary public ID. One photo is on one update; deleting the update
// removes the row. Placeholders are not stored here.
model Photo {
  id       String @id @default(cuid())
  updateId String
  publicId String @unique

  update Update @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@index([updateId])
}

// A person's one reaction to an update; picking another replaces it. `kind` is a catalog
// kind (see src/lib/reactionCatalog.ts), checked by the server.
model Reaction {
  id        String   @id @default(cuid())
  updateId  String
  personId  String
  kind      String
  createdAt DateTime @default(now())

  update Update @relation(fields: [updateId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([updateId, personId])
}

// The palette of note colors; the UI gives each its fill and text color.
enum NoteColor {
  sky
  teal
  sage
  oak
  rose
  lavender
}

// A note of support on an update. Anyone signed in to the family may leave any number. Its
// family is its update's family.
model Note {
  id        String    @id @default(cuid())
  updateId  String
  authorId  String
  // Empty for a video note. A note has a body or a video, never both (a check constraint).
  body      String
  // A video note's Cloudinary public ID, from an upload ticket this note's author was given.
  videoId   String?   @unique
  color     NoteColor
  createdAt DateTime  @default(now())

  update    Update         @relation(fields: [updateId], references: [id], onDelete: Cascade)
  author    Person         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions NoteReaction[]

  @@index([updateId, createdAt])
  @@index([authorId, createdAt])
}

// A person's one reaction to a note; picking another replaces it. `kind` is a catalog kind.
model NoteReaction {
  id        String   @id @default(cuid())
  noteId    String
  personId  String
  kind      String
  createdAt DateTime @default(now())

  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([noteId, personId])
}

// An upload ticket: a Cloudinary public ID the server signed an upload for, and whom for.
// Only that person can attach it to a note or an update, and tickets count toward an hourly
// limit whether or not they're used.
model VideoUpload {
  publicId  String   @id
  personId  String
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt])
}

// Something the family needs. slots is how many people can take it; null means no limit.
model HelpRequest {
  id        String   @id @default(cuid())
  familyId  String
  body         String
  slots        Int?
  // Whether an offer needs a name, and an email when the person has none on their record.
  requireName  Boolean  @default(true)
  requireEmail Boolean  @default(false)
  // Whether a supporter with no phone on their record gives one with their offer.
  requirePhone Boolean  @default(false)
  // Exactly as typed, with no time zone: the need happens where the family is.
  // "YYYY-MM-DD" and "HH:MM"; a time only with a date.
  date         String?
  time         String?
  createdAt    DateTime @default(now())

  family Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  offers HelpOffer[]

  @@index([familyId, createdAt])
}

// One person's offer to take a request. Withdrawing deletes the row.
model HelpOffer {
  id        String   @id @default(cuid())
  requestId String
  personId  String
  // Given with this offer when the request requires an email and the person has none on
  // their record. Only family members see it; it isn't verified and goes nowhere else.
  email     String?
  createdAt DateTime @default(now())

  request HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  person  Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([requestId, personId])
  @@index([personId])
}

// A wrong answer at a family's gate, counted against per-browser and per-network limits.
model GateAttempt {
  id        String   @id @default(cuid())
  familyId  String
  browserId String
  network   String
  createdAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, browserId, createdAt])
  @@index([familyId, network, createdAt])
}
