// Database schema. Models are added as the spec defines them.

generator client {
  provider            = "prisma-client"
  output              = "../server/generated/prisma"
  // .js import extensions keep the generated code runnable in Vercel's Node runtime.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Family {
  id              String   @id @default(cuid())
  slug            String   @unique
  displayName     String
  question        String
  acceptedAnswers String[]
  // The introduction of the message at the top of How to help, as plain text; null when there is none.
  helpMessage     String?
  // The same message as a checked document. Null for messages written before formatting.
  helpMessageContent Json?
  // The message's "Do" and "Don't" parts, as checked documents; null when not written.
  helpDo          Json?
  helpDont        Json?
  // The emoji anyone may react with on any of the family's notes, in catalog order; empty allows none.
  noteReactionKinds String[] @default(["heart", "hug", "strong", "clap", "party", "laugh"])
  // Where a new update's "Allow notes" starts in Post settings. Never changes posted updates.
  allowNotesByDefault Boolean @default(true)
  // The family's wording for the privacy banner atop every signed-in page; null shows the standard wording.
  privacyNotice   String?
  // Whether an admin may make updates public, readable without signing in. Off turns every public
  // update into an everyone update in the same transaction, so none is public while this is false.
  publicUpdatesOn Boolean  @default(false)
  // The family's wording for the banner on the signed-out page while it shows public updates; null shows the standard wording.
  publicNotice    String?
  // Set only when the family is created, and never changed. An invite-only family has no community
  // question (its question is empty and it has no accepted answers): supporters are added by a
  // family member and sign in by email.
  inviteOnly      Boolean  @default(false)
  createdAt       DateTime @default(now())

  people       Person[]
  gateAttempts GateAttempt[]
  updates      Update[]
  helpRequests HelpRequest[]
  groups       Group[]
  inviteRequests InviteRequest[]
}

enum Role {
  family
  supporter
}

// Family members and supporters. An email belongs to at most one person in a family.
model Person {
  id               String    @id @default(cuid())
  familyId         String
  role             Role
  // Both empty for a supporter who has only answered the question. A supporter gets a
  // name when they leave a note or give an email, and an email only by giving one.
  // Family members always have both.
  name             String?
  email            String? // lowercased and trimmed
  // Set when the person confirms their email, signs in by magic link, or a family member verifies it.
  emailVerifiedAt  DateTime?
  // Whether new updates are emailed to them.
  notificationsOn  Boolean   @default(true)
  // In each notification email's unsubscribe links. Stored as is: it can only turn off
  // this person's notifications. Generated by the database so existing rows get one.
  unsubscribeToken String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Set when a family member removes them. A removed person can't sign in,
  // join again, or get emails; the record stays so the email stays blocked.
  removedAt        DateTime?
  // Supporters only, kept as typed: for the family to call or text them. Only family members
  // see it. A database check keeps it null for family members.
  phone            String?
  // Family members only. Admins manage the family (see spec/access.md "Admins"); a database
  // check keeps it false for supporters.
  isAdmin          Boolean   @default(false)
  createdAt        DateTime  @default(now())

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  magicLinks   MagicLink[]
  sessions     Session[]
  updates      Update[]
  reactions     Reaction[]
  noteReactions NoteReaction[]
  notes         Note[]
  videoUploads  VideoUpload[]
  helpOffers    HelpOffer[]
  groupMemberships GroupMember[]

  @@unique([familyId, email])
}

// A sign-in link starts a session; a verify link only confirms the email.
enum LinkPurpose {
  sign_in
  verify
}

model MagicLink {
  id        String      @id @default(cuid())
  personId  String
  purpose   LinkPurpose @default(sign_in)
  tokenHash String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  personId  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Update {
  id        String    @id @default(cuid())
  familyId  String
  authorId  String
  // The update's plain text, kept in step with content (see server/richText.ts).
  body      String
  // The formatted document, checked by validDoc. Null for updates posted before formatting,
  // and for a video update, which has a videoId and no document.
  content   Json?
  // A video update's Cloudinary public ID, from an upload ticket its author was given.
  // Null for a text update. Unique, so one upload is on at most one update.
  videoId   String?   @unique
  // The reactions anyone may pick on this update, as catalog kinds in catalog order (see
  // src/lib/reactionCatalog.ts), at most six. Empty allows none.
  reactionKinds String[] @default(["heart", "hug", "strong", "clap", "party", "laugh"])
  // False stops new notes; the notes already on it stay.
  allowNotes Boolean  @default(true)
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  // Who can see it, besides family members, who see every update. `groups`: supporters in at
  // least one of its UpdateGroup rows. `groups` with no rows left is "Family members only".
  // No default, so every create must name it.
  audience  Audience

  family    Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author    Person        @relation(fields: [authorId], references: [id])
  reactions Reaction[]
  notes     Note[]
  photos    Photo[]
  groups    UpdateGroup[]

  @@index([familyId, createdAt])
}

enum Audience {
  everyone
  groups
  // Everyone signed in, and anyone who visits the family's address (server/publicUpdates.ts).
  public
}

// A family's named set of supporters. Names are unique per family ignoring capitals, which
// server/groups.ts enforces under the family's groups lock.
model Group {
  id        String   @id @default(cuid())
  familyId  String
  name      String
  createdAt DateTime @default(now())

  family  Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  members GroupMember[]
  updates UpdateGroup[]

  @@index([familyId])
}

model GroupMember {
  groupId  String
  personId String

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([groupId, personId])
  @@index([personId])
}

model UpdateGroup {
  updateId String
  groupId  String

  update Update @relation(fields: [updateId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([updateId, groupId])
  @@index([groupId])
}

// A real photo's Cloudinary public ID. One photo is on one update; deleting the update
// removes the row. Placeholders are not stored here. `takenAt` is the date the device read from
// the photo when it was added, if any; shown only to family members.
model Photo {
  id       String    @id @default(cuid())
  updateId String
  publicId String    @unique
  takenAt  DateTime?

  update Update @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@index([updateId])
}

// A person's one reaction to an update; picking another replaces it. `kind` is a catalog
// kind (see src/lib/reactionCatalog.ts), checked by the server.
model Reaction {
  id        String   @id @default(cuid())
  updateId  String
  personId  String
  kind      String
  createdAt DateTime @default(now())

  update Update @relation(fields: [updateId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([updateId, personId])
}

// The palette of note colors; the UI gives each its fill and text color.
enum NoteColor {
  sky
  teal
  sage
  oak
  rose
  lavender
}

// A note of support on an update. Anyone signed in to the family may leave any number. Its
// family is its update's family.
model Note {
  id        String    @id @default(cuid())
  updateId  String
  authorId  String
  // Empty for a video note. A note has a body or a video, never both (a check constraint).
  body      String
  // A video note's Cloudinary public ID, from an upload ticket this note's author was given.
  videoId   String?   @unique
  color     NoteColor
  createdAt DateTime  @default(now())
  // Only a family member's note can be for family members only; the server enforces it (a
  // supporter's is always false). A supporter never sees one.
  familyOnly Boolean  @default(false)

  update    Update         @relation(fields: [updateId], references: [id], onDelete: Cascade)
  author    Person         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions NoteReaction[]

  @@index([updateId, createdAt])
  @@index([authorId, createdAt])
}

// A person's one reaction to a note; picking another replaces it. `kind` is a catalog kind.
model NoteReaction {
  id        String   @id @default(cuid())
  noteId    String
  personId  String
  kind      String
  createdAt DateTime @default(now())

  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([noteId, personId])
}

// An upload ticket: a Cloudinary public ID the server signed an upload for, and whom for.
// Only that person can attach it to a note or an update, and tickets count toward an hourly
// limit whether or not they're used.
model VideoUpload {
  publicId  String   @id
  personId  String
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt])
}

// Something the family needs. slots is how many people can take it; null means no limit.
model HelpRequest {
  id        String   @id @default(cuid())
  familyId  String
  // The plain text of content, kept beside it. Requests from before formatting have only this.
  body         String
  content      Json?
  slots        Int?
  // Whether an offer needs a name, and an email when the person has none on their record.
  requireName  Boolean  @default(true)
  requireEmail Boolean  @default(false)
  // Whether a supporter with no phone on their record gives one with their offer.
  requirePhone Boolean  @default(false)
  // Exactly as typed, with no time zone: the need happens where the family is.
  // "YYYY-MM-DD" and "HH:MM"; a time only with a date.
  date         String?
  time         String?
  // When a family member marked it resolved; null while it's open.
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())

  family Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  offers HelpOffer[]

  @@index([familyId, createdAt])
}

// One person's offer to take a request. Withdrawing deletes the row.
model HelpOffer {
  id        String   @id @default(cuid())
  requestId String
  personId  String
  // Given with this offer when the request requires an email and the person has none on
  // their record. Only family members see it; it isn't verified and goes nowhere else.
  email     String?
  createdAt DateTime @default(now())

  request HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  person  Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([requestId, personId])
  @@index([personId])
}

// A wrong answer at a family's gate, counted against per-browser and per-network limits.
model GateAttempt {
  id        String   @id @default(cuid())
  familyId  String
  browserId String
  network   String
  createdAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, browserId, createdAt])
  @@index([familyId, network, createdAt])
}

// Someone who asked an invite-only family to add them. Not a Person: it has no session and no
// groups, and only a family member of the family ever reads it. Deleted when approved, declined
// or after 30 days.
model InviteRequest {
  id        String   @id @default(cuid())
  familyId  String
  name      String
  email     String   // normalized, as Person.email is
  message   String?
  network   String   // networkKey(), for the per-network limit
  createdAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, email])
  @@index([familyId, createdAt])
  @@index([familyId, network, createdAt])
}
