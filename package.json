{
  "name": "updates-and-support",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "prisma generate && vite build",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "family:create": "tsx scripts/create-family.ts",
    "family:rename": "tsx scripts/rename-family.ts",
    "email:test": "tsx scripts/send-test-email.ts",
    "start": "vercel dev",
    "vercel-build": "prisma generate && prisma migrate deploy && vite build",
    "preview": "scripts/preview.sh",
    "preview:seed": "scripts/with-preview-db.sh npx tsx scripts/seed-preview.ts",
    "preview:baseline": "scripts/with-preview-db.sh scripts/preview-baseline.sh",
    "verification:send": "tsx scripts/send-verifications.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^23.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.7",
    "jsdom": "^30.1.3",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vercel": "^63.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
