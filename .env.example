# Copy to .env and fill in. Never commit .env.

# The app's database. Locally, a Postgres on your machine; on Vercel, the Neon
# connection string (set in the Vercel project's environment variables).
DATABASE_URL="postgresql://USER@localhost:5432/updates_dev"

# A separate, disposable database for integration tests. Tests reset it freely.
TEST_DATABASE_URL="postgresql://USER@localhost:5432/updates_test"

# Email through Resend. Leave RESEND_API_KEY unset locally to log emails to the console.
RESEND_API_KEY=""
EMAIL_FROM="Updates and Support <updates@mail.orbul.com>"

# Photos and video notes, through Cloudinary. One variable, cloudinary://key:secret@cloud, from
# Cloudinary → Settings → API Keys. Use a separate account for Production and for Preview plus
# local work, and never paste the preview account's key into Production. Without it, new photos
# and video notes don't work. In each account, delete any unsigned upload preset it came with
# (Settings → Upload). CLOUDINARY_FOLDER is only where this copy of the app's videos go.
CLOUDINARY_URL=""
CLOUDINARY_FOLDER="updates-and-support/dev"

# The site's address, used for links in emails. Unset on previews, which use their branch address.
APP_URL="http://localhost:3000"

# Optional. The family shown at the site's root, and old family addresses that lead to current
# ones ("old=new,old2=new2"). Real addresses go only in Vercel's settings, never in this repository.
ROOT_FAMILY_SLUG=""
FAMILY_REDIRECTS=""

# Test sites only. "1" gives the editor grey placeholder photos that upload nothing, and only
# when CLOUDINARY_URL is unset. If CLOUDINARY_URL is set, new photos are real uploads even when
# this is 1; placeholders already saved stay grey. Production ignores this even if set.
PHOTO_PLACEHOLDERS=""

# Local only, for checking previews (see README → Deployment).
# Your address for the preview test family's family member.
PREVIEW_FAMILY_EMAIL=""
# The Neon `preview` branch's pooled and direct connection strings (the same values as
# Vercel's Preview DATABASE_URL and DATABASE_URL_UNPOOLED).
PREVIEW_DATABASE_URL=""
PREVIEW_DATABASE_URL_UNPOOLED=""
# From Vercel → Settings → Deployment Protection → Protection Bypass for Automation.
VERCEL_AUTOMATION_BYPASS_SECRET=""
